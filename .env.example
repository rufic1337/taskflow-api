SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use local SQLite. Set for PostgreSQL (used by docker-compose):
DATABASE_URL=postgres://taskflow:taskflow@db:5432/taskflow

# Leave unset to fall back to an in-memory Channels layer (single-process only).
# Set for docker-compose / production with a real Redis instance:
REDIS_URL=redis://redis:6379/0

# Runs Celery tasks synchronously (no worker required). Set to False if you're
# running a separate `celery -A config worker` process.
CELERY_TASK_ALWAYS_EAGER=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

SEED_DEMO_DATA=false
